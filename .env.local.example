# Generate .env.local from this template with: python3.11 scripts/init_local_env.py
ENVIRONMENT=development
ECHOSENSE_VENV_DIR=.venv-local

ECHOSENSE_POSTGRES_HOST=127.0.0.1
ECHOSENSE_POSTGRES_PORT=55432
ECHOSENSE_POSTGRES_DB=echosense_dev
ECHOSENSE_POSTGRES_TEST_DB=echosense_test
ECHOSENSE_POSTGRES_USER=echosense_dev
ECHOSENSE_POSTGRES_PASSWORD=replace-with-generated-local-postgres-password

DATABASE_URL=postgresql+asyncpg://echosense_dev:replace-with-generated-local-postgres-password@127.0.0.1:55432/echosense_dev
ALEMBIC_DATABASE_URL=postgresql://echosense_dev:replace-with-generated-local-postgres-password@127.0.0.1:55432/echosense_dev
ECHOSENSE_TEST_DATABASE_URL=postgresql+asyncpg://echosense_dev:replace-with-generated-local-postgres-password@127.0.0.1:55432/echosense_test

SECRET_KEY=replace-with-generated-local-secret-key
APP_NAME="EchoSense Local API"
TRUSTED_PROXY_CIDRS=
ECHOSENSE_CONTROLLED_TEST_MODE=true
# ECHOSENSE_CONTROLLED_TEST_USER_ID is intentionally unset so local pushes are skipped.
ECHOSENSE_ALLOW_TEST_ALERTS=true
ECHOSENSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXPO_ACCESS_TOKEN=
RUN_LEGACY_STARTUP_MAINTENANCE=false
SQL_ECHO=false
TESTING=false

ECHOSENSE_LOCAL_API_URL=http://127.0.0.1:8000
ECHOSENSE_DEV_ADMIN_EMAIL=admin@echosense.local
ECHOSENSE_DEV_ADMIN_PASSWORD=replace-with-generated-local-admin-password
ECHOSENSE_DEV_STAFF_EMAIL=staff@echosense.local
ECHOSENSE_DEV_STAFF_PASSWORD=replace-with-generated-local-staff-password
ECHOSENSE_DEV_COUNSELOR_EMAIL=counselor@echosense.local
ECHOSENSE_DEV_COUNSELOR_PASSWORD=replace-with-generated-local-counselor-password
ECHOSENSE_DEV_SCHOOL="EchoSense Development"
ECHOSENSE_DEV_CLASSROOM="Test Classroom"
ECHOSENSE_DEV_DEVICE_CODE=classroom-pi-01
ECHOSENSE_DEV_DEVICE_NAME="Classroom Pi 01"
ECHOSENSE_DEVICE_CREDENTIALS_FILE=.env.local.device
