# Generate .env.integration from the existing private .env with:
# .venv-local/bin/python scripts/init_integration_env.py
ENVIRONMENT=integration
ECHOSENSE_VENV_DIR=.venv-local

DATABASE_URL=copy-existing-neon-url-without-committing-it
SECRET_KEY=copy-existing-secret-key-without-committing-it
APP_NAME="EchoSense Local Integration API"
TRUSTED_PROXY_CIDRS=
ECHOSENSE_CONTROLLED_TEST_MODE=false
# ECHOSENSE_CONTROLLED_TEST_USER_ID is intentionally unset.
ECHOSENSE_ALLOW_TEST_ALERTS=false
ECHOSENSE_CORS_ORIGINS=https://echosense-frontend.vercel.app
EXPO_ACCESS_TOKEN=
RUN_LEGACY_STARTUP_MAINTENANCE=false
SQL_ECHO=false
TESTING=false
