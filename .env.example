ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/echosense_dev
ALEMBIC_DATABASE_URL=postgresql://username:password@localhost:5432/echosense_dev
ECHOSENSE_TEST_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/echosense_test
SECRET_KEY=replace-with-a-secure-random-value
APP_NAME=EchoSense API
TRUSTED_PROXY_CIDRS=
ECHOSENSE_CONTROLLED_TEST_MODE=false
# ECHOSENSE_CONTROLLED_TEST_USER_ID is optional and unset by default.
ECHOSENSE_ALLOW_TEST_ALERTS=false
ECHOSENSE_CORS_ORIGINS=http://localhost:3000
EXPO_ACCESS_TOKEN=
RUN_LEGACY_STARTUP_MAINTENANCE=false
SQL_ECHO=false
TESTING=false
